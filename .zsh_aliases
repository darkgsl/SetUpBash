cat > ~/.zsh_aliases << 'EOF'
# Git aliases
alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gac='git add . && git commit -m'
alias gp='git push'
alias gl='git log --oneline --graph --all'
alias gd='git diff'

# Docker
alias d='docker'
alias di='docker images'
alias dps='docker ps'
alias dc='docker compose'

# Kubernetes
alias k='kubectl'
alias kgp='kubectl get pods'
EOF
